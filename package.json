  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "grpc-server-proto": "protoc --plugin=./node_modules/.bin/protoc-gen-ts.cmd --ts_proto_out=./ --ts_proto_opt=addGrpcMetadata=true --ts_proto_opt=nestJs=true,snakeToCamel=false ./src/config/grpc/server/protos/*.proto",
    "grpc-client-proto": "protoc --plugin=./node_modules/.bin/protoc-gen-ts.cmd --ts_proto_out=./ --ts_proto_opt=addGrpcMetadata=true --ts_proto_opt=nestJs=true,snakeToCamel=false ./src/config/grpc/client/protos/*.proto"
  },
