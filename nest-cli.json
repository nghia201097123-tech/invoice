{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "compilerOptions": {
    "assets": [
      {
        "include": "version_3/invoices/templates/**/*",
        "outDir": "dist/src"
      },
      {
        "include": "**/*.proto",
        "outDir": "dist/src"
      },
      {
        "include": "**/*.js",
        "outDir": "dist/src"
      },
      {
        "include": "**/*.entity",
        "outDir": "dist/src"
      }
    ],
    "deleteOutDir": true,
    "watchAssets": true
  },
  "sourceRoot": "src"
  
}